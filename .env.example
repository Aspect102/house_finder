# ---- House Finder configuration ----
# Copy to .env and edit.

# Database
HF_DATABASE_URL=sqlite:///./house_finder.db

# Web server
HF_HOST=127.0.0.1
HF_PORT=8000

# Scheduler (internal timer; used when running as a systemd service)
HF_SCHEDULER_ENABLED=true
HF_SYNC_INTERVAL_MINUTES=180
# Run one sync shortly after startup
HF_SYNC_ON_STARTUP=false

# Search defaults
HF_DEFAULT_BEDS=6
HF_DEFAULT_LOCATION=Bath, UK
HF_DEFAULT_MAX_PRICE=0
HF_DEFAULT_MIN_PRICE=0

# Enabled sources (comma-separated). Available:
# rightmove, zoopla, onthemarket, openrent, spareroom, unihomes
# SpareRoom is room-oriented and often challenged, so it is opt-in.
HF_SOURCES=rightmove,unihomes,openrent,onthemarket,zoopla

# Scraping behaviour
HF_REQUEST_TIMEOUT=25
HF_REQUEST_DELAY_SECONDS=1.5
HF_MAX_RESULTS_PER_SOURCE=60
HF_MAX_PAGES_PER_SOURCE=6
HF_USER_AGENT=Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0 Safari/537.36
HF_RESPECT_ROBOTS=true
# Use Playwright headless browser when HTTP scraping fails (required for Zoopla)
HF_USE_PLAYWRIGHT_FALLBACK=true
HF_BROWSER_SETTLE_MS=2500

# Notifications (all optional)
HF_NOTIFY_ENABLED=false
HF_NOTIFY_ON_NEW=true

# Email (SMTP)
HF_SMTP_HOST=
HF_SMTP_PORT=587
HF_SMTP_USER=
HF_SMTP_PASSWORD=
HF_SMTP_USE_TLS=true
HF_EMAIL_FROM=
HF_EMAIL_TO=

# Webhook (Discord/Slack incoming webhook URL)
HF_WEBHOOK_URL=

# ---- Transit / bus routes (Bus Open Data Service) ----
# Get an API key at https://data.bus-data.dft.gov.uk/account/
HF_BODS_API_KEY=
# Lines to track. "LINE" matches any operator; "LINE@OPERATOR" restricts by a
# case-insensitive operator substring (e.g. "20@Big Lemon").
HF_BODS_ROUTES=U1,U1N,U2,U3,U4,U6,20@Big Lemon
# ATCO administrative areas used to keep stops local (018 = Bath & NE Somerset).
HF_BODS_ADMIN_AREAS=018
# How often the scheduler refreshes routes/stops.
HF_BODS_REFRESH_HOURS=168
# Default maximum walk from a selected-route stop, in metres.
HF_DEFAULT_MAX_STOP_DISTANCE_M=800
# Geocode listings that lack coordinates but have a postcode (postcodes.io).
HF_GEOCODE_ENABLED=true
